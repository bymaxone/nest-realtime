{
  "name": "@bymax-one/nest-realtime",
  "version": "1.1.2",
  "description": "Realtime backend → frontend communication for NestJS — dual-transport SSE (default) and WebSocket (opt-in) with a unified server-side API.",
  "author": "Bymax One <support@bymax.one>",
  "license": "MIT",
  "homepage": "https://github.com/bymaxone/nest-realtime#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bymaxone/nest-realtime.git"
  },
  "bugs": {
    "url": "https://github.com/bymaxone/nest-realtime/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/server/index.cjs",
  "module": "./dist/server/index.mjs",
  "types": "./dist/server/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.mjs"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.mjs"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./websocket": {
      "import": {
        "types": "./dist/websocket/index.d.ts",
        "default": "./dist/websocket/index.mjs"
      },
      "require": {
        "types": "./dist/websocket/index.d.cts",
        "default": "./dist/websocket/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal/index.d.ts",
        "default": "./dist/internal/index.mjs"
      },
      "require": {
        "types": "./dist/internal/index.d.cts",
        "default": "./dist/internal/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "shared": [
        "./dist/shared/index.d.cts"
      ],
      "react": [
        "./dist/react/index.d.cts"
      ],
      "websocket": [
        "./dist/websocket/index.d.cts"
      ],
      "internal": [
        "./dist/internal/index.d.cts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && tsup",
    "check:exports": "attw --pack . --profile strict",
    "check:mutants": "node scripts/check-mutation-directives.mjs",
    "check:published": "node scripts/check-published-surface.mjs",
    "check:runtime": "node scripts/check-consumer-runtime.mjs",
    "check:surface": "node scripts/check-public-surface.mjs",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "mutation": "stryker run",
    "mutation:full": "node -e \"require('node:fs').rmSync('reports/stryker-incremental.json',{force:true,recursive:true})\" && stryker run",
    "mutation:dry-run": "stryker run --dryRunOnly",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm check:mutants && pnpm test:cov:all && pnpm build && pnpm check:published && pnpm check:surface && pnpm check:runtime",
    "release": "npm publish --provenance --access public",
    "size": "node scripts/check-size.mjs",
    "test": "jest",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:cov": "jest --config jest.coverage.config.ts --coverage",
    "test:cov:all": "jest --config jest.coverage.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "test:e2e:cross-instance": "jest --config jest.e2e.cross-instance.config.ts --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.16",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@socket.io/redis-adapter": "^8.0.0",
    "ioredis": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    },
    "@nestjs/platform-socket.io": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "@socket.io/redis-adapter": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@socket.io/redis-adapter": "^8.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "eventsource": "^5.1.0",
    "ioredis": "^6.0.0",
    "ioredis-mock": "^8.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jsonwebtoken": "^9.0.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.6.2",
    "socket.io-client": "^4.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "tslib": "^2.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "nestjs",
    "realtime",
    "sse",
    "server-sent-events",
    "websocket",
    "socket.io",
    "pubsub",
    "redis",
    "multi-tenant",
    "presence",
    "event-replay",
    "offline-queue",
    "react-hooks",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
